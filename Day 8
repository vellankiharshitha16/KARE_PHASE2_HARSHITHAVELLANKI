// printing the array in the reverse oredr


import java.util.*;
class Main{
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int arr[] = new int[n];
        int i;
        for(i=0;i<n;i++)
        arr[i]=obj.nextInt();
        for(i=n-1;i>=0;i--)
        System.out.print(arr[i]+ " ");
    }
}


