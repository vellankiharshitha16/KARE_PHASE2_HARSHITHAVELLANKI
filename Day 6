//PERFECT NUBER

STEP1:GET THE INPUT FROM THE USER N=6
STEP2: FIND THE FACTOR OF N VALUE INCLDING 1 EXCLUDING THE GIVIN NUMBER(1,2,3)
STEP 3 : FIND THE SUM OF THE FACTORS (SUM = 1+2+3)
STEP4:COMPARE THE SUM AND GIVEN NUMBER . IF BOTH ARE EQUAL THEN IT IS A PERFECT NUMBER ELSE NOT A PERFECT NUMBER .

import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int i,sum=0;
        for(i=1;i<=n/2;i++)
        {
            if(n%i==0)
            sum+=i;
        }
        if(sum==n)
        System.out.println("Perfect number");
        else
        System.out.println("Not a perfect number");
    }
}
