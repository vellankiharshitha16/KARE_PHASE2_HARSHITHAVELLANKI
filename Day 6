// Write a java program to count odd number digits and even number digits 
import java.util.*;
class Main{
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int d,ec=0,oc=0;
        while(n!=0)
        {
            d=n%10;
            if(d%2==0)
            ec++;
            else 
            oc++;
            n = n/10;
        }
        System.out.println("odd digit : " +oc);
        System.out.println("even digit : " +ec);
    }
}

// write a java program to count the prime numberrs in the given number

import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int d,c=0;
        while(n!=0)
        {
            d = n%10;
            if(d==2||d==3||d==5||d==7)
            c++;
            n=n/10;
        }
        System.out.println("Prime numbers : " +c);
    }
}


