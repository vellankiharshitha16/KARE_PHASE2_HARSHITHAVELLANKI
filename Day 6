// To count number of digits in the given number 

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n = obj.nextInt();
	    int c=0;
	    while(n!=0) 
	    {
	        n = n/10;
	        c++;
	    }
		System.out.println("no.of digits : " +c);
	}
}


// Write a java program to print the reverse number

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner obj = new Scanner(System.in);
	    int n = obj.nextInt();
	    int d,ans=0;
	    while(n!=0)
	    {
	        d = n%10;
	        ans = ans*10+d;
	        n = n/10;
	    }
		System.out.println("Reverse number : " +ans);
	}
}

