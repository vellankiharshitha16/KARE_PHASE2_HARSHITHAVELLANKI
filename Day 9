public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        int i;
        int mx = Integer.MIN_VALUE;
        for (i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
            if (arr[i] > mx) {
                mx = arr[i];
            }
        }
        for (i = 0; i < n; i++) {
            if (arr[i] == mx) {
                arr[i] = 0;
            }
        }
        int secondMx = Integer.MIN_VALUE;
        for (i = 0; i < n; i++) {
            if (arr[i] > secondMx) {
                secondMx = arr[i];
            }
        }
        System.out.println(" the second max value is "+secondMx);
    }
}
