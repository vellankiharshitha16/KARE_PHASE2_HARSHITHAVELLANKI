import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int i,j;
        for(i=0;i<n;i++){
            for(j=1;j<=i+1;j++){
                if(i%2==0){
                System.out.print(2*j-1);
            }
            else{
                System.out.print(2*j);
            }
        }
        System.out.println();
    }
}
}

