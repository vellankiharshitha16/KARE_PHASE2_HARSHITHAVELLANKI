import java.util.*;
public class Main{
    public static void main(String[] args){
        Stack<Integer> obj = new Stack();
        int i;
        Scanner sc = new Scanner(System.in);
        int n =sc.nextInt();
        for(i=0;i<n;i++){
            obj.push(sc.nextInt());
        }
        System.out.println("Stack elements");
        System.out.println(obj);
        obj.pop();
        System.out.println("After removing one element");
        System.out.println(obj);
        System.out.println("The peek element of the stack is ");
        System.out.println(obj.peek());
        System.out.println(obj);
        System.out.println("check whether the stack is empty or not");
        System.out.println(obj.empty());
        System.out.println("search for the element 10 in the stack");
        System.out.println(obj.search(10));
        obj.add(50);
        System.out.println("After adding the element 50 at the end of the stack");
        System.out.println(obj);
        System.out.println("Enter the index you would like to get the value");
        int idx = sc.nextInt();
        System.out.println(obj.get(idx));
        System.out.println("Enter the value you would like to check whether its in the stack or not");
        int val = sc.nextInt();
        System.out.println(obj.contains(val));
        System.out.println("Enter the index of the you would like to remove");
        idx = sc.nextInt();
        obj.remove(idx);
        System.out.println(obj);
        
    }
}

