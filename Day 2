import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    int a =29;
	    int b = a++;
	    int c = --b;
	    int d = c++;
	    int e = ++d;
		System.out.println("a = " + a + "b = "+"c = " + c + "d = " + d + "e = " + e);
	}
